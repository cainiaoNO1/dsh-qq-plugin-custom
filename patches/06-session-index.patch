+/** 判断是否是合法会话目录名：支持传统的 session-<uuid>，也支持现代 DSH 直接以 UUID 命名的会话。 */
+export function isSessionDir(name) {
+  return (
+    typeof name === 'string' &&
+    (name.startsWith('session-') ||
+      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(name))
+  )
+}
